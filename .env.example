# Portfolio App — Docker Compose Environment
# Copy to .env and fill in real values

# Docker image
IMAGE_NAME=lexmakesit/portfolio
IMAGE_TAG=latest

# Application
SECRET_KEY=change-me-to-a-secure-random-string-min-32-chars
PRODUCTION=true
ALLOWED_ORIGINS=https://lexmakesit.com,https://www.lexmakesit.com
DOMAIN=lexmakesit.com

# PostgreSQL
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=your_postgres_password_here

# SMTP (email contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password_here

# GitHub Actions Secrets (set in repo settings, not .env)
# PORTFOLIO_HOST=104.236.100.245
# PORTFOLIO_USER=lex
# PORTFOLIO_SSH_KEY=<paste private key>
