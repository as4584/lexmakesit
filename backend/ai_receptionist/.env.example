APP_ENV=local
ENVIRONMENT=local

# Twilio credentials (example placeholders)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15555550123

# Security keys
ADMIN_PRIVATE_KEY=change-this-admin-key
JWT_SECRET_KEY=change-this-jwt-signing-key
ENCRYPTION_KEY=replace-with-fernet-key
ENCRYPTION_SALT=replace-with-base64-random-salt

# Redis
REDIS_URL=redis://:change-this-in-production@redis:6379/0
REDIS_PASSWORD=change-this-in-production
