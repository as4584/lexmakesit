# .act/secrets.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .act/secrets (git-ignored) and fill in your values.
# These match the GitHub Actions secrets used by the root workflows.
# ─────────────────────────────────────────────────────────────────────────────

# GitHub token with read:packages scope for GHCR pulls (local only)
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# ── Doppler ──────────────────────────────────────────────────────────────────
# Replaces all service-specific ENV blob secrets (AI_ENV, PORTFOLIO_ENV, etc.)
# Create a service token at https://dashboard.doppler.com → project → config → Service Tokens
DOPPLER_TOKEN=dp.st.YOUR_SERVICE_TOKEN_HERE

# ── Deploy target (only needed if running the deploy job locally) ─────────────
SERVER_HOST=your.server.ip
SERVER_USER=deploy
SSH_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
# ...paste key here (multi-line)...
-----END OPENSSH PRIVATE KEY-----

